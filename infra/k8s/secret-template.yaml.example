apiVersion: v1
kind: Secret
metadata:
  name: carelens-runtime
  namespace: carelens
type: Opaque
stringData:
  MONGODB_URI: "REPLACE_WITH_APPLICATION_USER_URI"
  MONGODB_MIGRATION_URI: "REPLACE_WITH_MIGRATION_USER_URI"
  MONGO_INITDB_ROOT_USERNAME: "REPLACE_WITH_MONGO_ROOT_USERNAME"
  MONGO_INITDB_ROOT_PASSWORD: "REPLACE_WITH_RANDOM_MONGO_ROOT_PASSWORD"
  MONGO_REPLICA_KEYFILE: "REPLACE_WITH_RANDOM_MONGO_REPLICA_KEYFILE"
  QUEUE_REDIS_URL: "REPLACE_WITH_QUEUE_REDIS_URI"
  QUEUE_REDIS_PASSWORD: "REPLACE_WITH_RANDOM_QUEUE_REDIS_PASSWORD"
  CACHE_REDIS_URL: "REPLACE_WITH_CACHE_REDIS_URI"
  CACHE_REDIS_PASSWORD: "REPLACE_WITH_RANDOM_CACHE_REDIS_PASSWORD"
  JWT_SIGNING_SECRET: "REPLACE_WITH_RANDOM_SECRET"
  OIDC_TRANSACTION_KEY: "REPLACE_WITH_RANDOM_SECRET"
  OIDC_REDIRECT_URI: "https://REPLACE_WITH_HOST/api/v1/auth/callback"
  JWT_ISSUER: "https://REPLACE_WITH_HOST"
  JWT_AUDIENCE: "carelens-api"
  GOOGLE_CLIENT_ID: "REPLACE_WITH_OIDC_CLIENT_ID"
  GOOGLE_CLIENT_SECRET: "REPLACE_WITH_OIDC_CLIENT_SECRET"
