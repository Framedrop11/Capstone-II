{
  "name": "carelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/core-api",
    "services/worker"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test .test-dist/tests/unit/data-models.test.js",
    "test:integration": "npm run build:test && node --test .test-dist/tests/integration/audit-immutability.test.js",
    "db:migrate": "migrate-mongo up -f services/core-api/migrate-mongo-config.cjs",
    "db:rollback": "migrate-mongo down -f services/core-api/migrate-mongo-config.cjs",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testcontainers/mongodb": "^11.10.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "testcontainers": "^11.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "migrate-mongo": "^14.0.7",
    "mongoose": "^8.24.8"
  }
}
