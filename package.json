{
  "name": "carelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "services/core-api", "services/worker"],
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
